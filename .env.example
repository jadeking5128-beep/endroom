# Configure these in Vercel Project Settings > Environment Variables.
# All values are server-only. Never use NEXT_PUBLIC_ or VITE_ prefixes.
ENDROOM_USERNAME=your-login-name
ENDROOM_PASSWORD_HASH=scrypt$replace-with-generated-hash
SESSION_SECRET=replace-with-32-byte-base64-secret
E2B_API_KEY=your-sandbox-provider-api-key
